               // Otherwise, handle existing char
               if ("count(csReqPer_schema/personCharGroup/personCharacteristic[characteristicType = $characteristicType and effectiveDate = $effectiveDate]) = 0")
                    move "$char" to "csReqPer_schema/personCharGroup/+personCharacteristic";
               else
                    move "parm/input/control/personCharacteristics/personCharacteristic[characteristicType = $characteristicType]/existingValuesHandling" to $existingValuesHandling;
