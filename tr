          if ("string($routingMethod) = 'EMAIL'")
               if ("count(parm/input/panel/emailAddresses/personContactDetail[personContactType = $personContactType and contactDetailValue = $contactDetailValue and string(contactDetailValueExtension) = $contactDetailValueExtension]) = 0")
                    move null to "csReqPer_schema/personContactGroup/personContactDetail[personContactType = $personContactType and contactDetailValue = $contactDetailValue and string(contactDetailValueExtension) = $contactDetailValueExtension]";
