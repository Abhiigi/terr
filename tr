                    end-if;
                    // Update Value Only
                    if ("string($existingValuesHandling) = 'C1VA'")
                         move "$char" to "csReqPer_schema/personCharGroup/personCharacteristic[characteristicType = $characteristicType and effectiveDate = $effectiveDate]";
                    end-if;
