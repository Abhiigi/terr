                         move "$CURRENT-DATE" to "csReqPer_schema/personCharGroup/personCharacteristic[characteristicType = $characteristicType and effectiveDate = $effectiveDate]/effectiveDate";
                    end-if;
               end-if;
          end-if;
     end-for;
