          if ("string($char/characteristicValue) = $BLANK and string($char/adhocCharacteristicValue) = $BLANK and string($char/characteristicValueForeignKey1) = $BLANK")
               move null to "csReqPer_schema/personCharGroup/personCharacteristic[characteristicType = $characteristicType]";
          else
